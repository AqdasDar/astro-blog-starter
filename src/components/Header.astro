---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import {getLangFromUrl, useTranslations} from '../i18n/utils';
import logoSvg from '../assets/Aesthetic Production Logo White.svg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header>
	<nav aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
		<div class="brand">
            <a href={`/${lang}/`}>
                <img src={logoLight.src} alt="Aesthetic Production Logo" class="logo-light" height="60" />
                <img src={logoDark.src} alt="Aesthetic Production Logo" class="logo-dark" height="60" />
            </a>
		</div>
		<div class="internal-links">
            <HeaderLink href={`/${lang}/`}>{t('nav.home')}</HeaderLink>
            <HeaderLink href={`/${lang}/productions/`}>{t('nav.productions')}</HeaderLink>
	        <HeaderLink href={`/${lang}/filmographie/`}>{t('nav.filmographie')}</HeaderLink>
            <HeaderLink href={`/${lang}/about/`}>{t('nav.about')}</HeaderLink>
            <HeaderLink href={`/${lang}/contact/`}>{t('nav.contact')}</HeaderLink>
		</div>
        <div class="controls">
			<ThemeToggle />
            <LanguageSwitcher/>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		transition: background-color 0.2s ease-in-out;
	}
	html.dark header {
		background: #16223a;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
        gap: 1em;
        min-height: 85px;
	}
	.brand {
        flex: 0 1 auto;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .brand a {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
	}

    .brand img {
        height: 60px;
        width: auto;
        max-height: 90px;
        border-radius: 0;
        display: block;
        transition: filter 0.2s ease-in-out;
        /* En mode clair (fond blanc), adaptation du SVG blanc vers le bleu marine #16223a */
        filter: brightness(0) saturate(100%) invert(11%) sepia(34%) saturate(1478%) hue-rotate(185deg) brightness(94%) contrast(94%);
    }

    :global(html.dark) .brand img {
        /* En mode sombre (fond #16223a), le SVG reste blanc pur */
        filter: none;
    }

    .internal-links {
        flex: 1 1 auto;
        display: flex;
        justify-content: center;
        gap: 1em;
    }

    .controls {
        flex: 0 1 auto;
        display: flex;
        gap: 0.5em;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}

    @media (max-width: 768px) {
        /* Adjusted breakpoint */
		nav {
			flex-direction: column;
			gap: 1em;
			padding: 1em 0;
		}
		.internal-links {
            order: 1; /* Place links below brand and controls */
			flex-wrap: wrap;
			gap: 0.5em 1em;
		}
        .brand img {
            height: 75px;
        }
	}
</style>
